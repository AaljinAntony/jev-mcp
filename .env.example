# Required: TypeSafe API key (never commit the real .env)
TYPESAFE_API_KEY=apikey_*******************************************************************************************

# Optional: model used for system_one calls (default: jev-latest)
# JEV_MCP_MODEL=jev-latest

# Optional: total per-tool-call budget in milliseconds (default: 30000).
#  This is the whole call, retries and backoff included - not a per-attempt
#  timeout. It is also enforced in mock mode, which is CPU-bound.
# JEV_MCP_TIMEOUT_MS=30000

# Optional: directories an LLM-supplied `root_dir` may resolve inside, separated
#  by the OS path separator (';' on Windows, ':' on POSIX). Default: empty, which
#  means only the process working directory and its ancestors are allowed.
#  Relative entries and entries that do not exist are ignored.
# JEV_MCP_ALLOWED_ROOTS=D:/work/other-project;D:/work/shared

# Optional: circuit breaker. After this many consecutive provider failures the
#  server stops paying the retry budget and fails fast until the cooldown is up.
# JEV_MCP_BREAKER_THRESHOLD=3
# JEV_MCP_BREAKER_COOLDOWN_S=30
#  Auth failures (401/403) use a longer window: a bad key does not fix itself.
# JEV_MCP_AUTH_COOLDOWN_S=300

# Optional: run the deterministic offline judge instead of the live API.
#  1 / true / yes / on  -> offline mock (tests & demos only)
#  0 / false / no / off -> live TypeSafe (default)
# JEV_MCP_MOCK=0

# Optional: policy thresholds, 0 <= review_at <= auto_accept <= 1
# JEV_MCP_AUTO_ACCEPT=0.8
# JEV_MCP_REVIEW_AT=0.5

# Optional: absolute path to the server log file (default: <repo>/logs/jev_engine.log)
# JEV_MCP_LOG_FILE=D:/mcp/jev-typesafe-mcp/logs/jev_engine.log